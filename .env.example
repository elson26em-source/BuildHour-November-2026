# Ingestion and retrieval do not need API keys. Live answers do.
# Set the key for the provider selected in config.yaml (groq by default).
# On Vercel, add these as Project Environment Variables instead of a .env file.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
